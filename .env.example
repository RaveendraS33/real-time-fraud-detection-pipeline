# Application
APP_ENV=development
LOG_LEVEL=INFO

# Kafka (use kafka:29092 from containers and localhost:9092 from the host)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRANSACTIONS_TOPIC=transactions.raw
FRAUD_DECISIONS_TOPIC=transactions.scored
FRAUD_ALERTS_TOPIC=fraud.alerts

# PostgreSQL
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_app
POSTGRES_PASSWORD=fraud_dev_password
DATABASE_URL=postgresql://fraud_app:fraud_dev_password@localhost:5432/fraud_detection

